<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="LightSync.Desktop.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock.caption">
      <Setter Property="Foreground" Value="#9AAAC0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="#182232" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="20" />
      <Setter Property="BorderBrush" Value="#2B3A4E" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#7458ED" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="18,10" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="NumericUpDown.compact">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="6,4" />
    </Style>
    <Style Selector="NumericUpDown.compact /template/ ButtonSpinner#PART_Spinner /template/ StackPanel#PART_SpinnerPanel">
      <Setter Property="Orientation" Value="Vertical" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="NumericUpDown.compact /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton">
      <Setter Property="Height" Value="16" />
      <Setter Property="Padding" Value="0" />
    </Style>
  </Application.Styles>
</Application>
