<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Cleared so that a machine-level private feed is never used to build this
       public repository; everything here resolves from nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
